<group name="secure_db_manager,">

  <!-- 100001: Single login failure -->
  <rule id="100001" level="5">
    <if_sid>86600</if_sid>
    <field name="event_type">^auth\.login\.failed$</field>
    <description>secure-db-manager: Login failure for user $(username)</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- 100002: Brute force — 5 failures in 60 seconds for the same username -->
  <rule id="100002" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100001</if_matched_sid>
    <same_field>username</same_field>
    <description>secure-db-manager: Brute force attack detected for user $(username)</description>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- 100003: Permission denied (403) -->
  <rule id="100003" level="6">
    <if_sid>86600</if_sid>
    <field name="event_type">^permission\.denied$</field>
    <description>secure-db-manager: Permission denied for user $(username) on $(path)</description>
    <group>access_control,</group>
  </rule>

  <!-- 100004: Successful login after previous failures (within 5 min) -->
  <rule id="100004" level="12" timeframe="300">
    <if_matched_sid>100001</if_matched_sid>
    <field name="event_type">^auth\.login\.success$</field>
    <same_field>username</same_field>
    <description>secure-db-manager: Login success after failures for user $(username)</description>
    <group>authentication_success,</group>
  </rule>

  <!-- 100005: Unauthorized request (missing or invalid JWT) -->
  <rule id="100005" level="4">
    <if_sid>86600</if_sid>
    <field name="event_type">^auth\.unauthorized$</field>
    <description>secure-db-manager: Unauthorized request to $(path) from $(client_ip)</description>
    <group>authentication_failed,</group>
  </rule>

</group>
